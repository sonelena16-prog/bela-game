/** Google Apps Script, привязанный к закрытой Google Таблице учителя. */
const SHEET_NAME = 'Бэла — результаты';
const ORIGIN_PROPERTY = 'APP_ORIGINS';
const HEADERS = ['Получено','Код работы','Попытка','Фамилия','Имя','Класс','Начало','Завершение','Верно на этапе 1 / 5','Верно на этапе 2 / 7','Верно на этапе 3 / 5','Верно на этапе 4 / 5','Верно на этапе 5 / 7','Итог / 20','Все выбранные ответы','Отметка','Комментарий учителя'];
function onOpen(){SpreadsheetApp.getUi().createMenu('Бэла').addItem('Подготовить лист результатов','setup').addItem('Импортировать JSON работы','showImport').addToUi();}
function setup(){const ss=SpreadsheetApp.getActiveSpreadsheet();if(!ss)throw new Error('Откройте скрипт из Google Таблицы.');PropertiesService.getScriptProperties().setProperty('SPREADSHEET_ID',ss.getId());const sheet=getSheet_();sheet.setFrozenRows(1);sheet.getRange(1,1,1,HEADERS.length).setFontWeight('bold').setBackground('#244e4c').setFontColor('#ffffff');sheet.setColumnWidths(1,HEADERS.length,160);sheet.setColumnWidth(15,500);if(!sheet.getFilter())sheet.getRange(1,1,sheet.getMaxRows(),HEADERS.length).createFilter();return 'Лист готов';}
function getSheet_(){const id=PropertiesService.getScriptProperties().getProperty('SPREADSHEET_ID');if(!id)throw new Error('Учителю нужно запустить setup.');const ss=SpreadsheetApp.openById(id);let sh=ss.getSheetByName(SHEET_NAME);if(!sh)sh=ss.insertSheet(SHEET_NAME);if(sh.getLastRow()===0)sh.appendRow(HEADERS);return sh;}
function doGet(){return HtmlService.createHtmlOutput('Приём работ «Бэла» настроен. Результаты таблицы через этот адрес не выдаются.');}
function doPost(e){let p,id='',origin='';try{const raw=e&&e.parameter&&e.parameter.payload;if(!raw||raw.length>70000)throw new Error('Некорректный объём работы.');p=JSON.parse(raw);id=typeof p.submissionId==='string'?p.submissionId:'';origin=typeof p.origin==='string'?p.origin:'';const allowed=(PropertiesService.getScriptProperties().getProperty(ORIGIN_PROPERTY)||'').split(',').map(s=>s.trim()).filter(Boolean);if(!allowed.includes(origin))throw new Error('Учителю нужно добавить адрес сайта в APP_ORIGINS.');const reply=storeWork_(p);return ack_({type:'bela-result',submissionId:id,ok:true,receipt:reply.receipt},origin);}catch(error){return ack_({type:'bela-result',submissionId:id,ok:false,error:String(error.message||'Не удалось записать работу.')},origin);}}
function ack_(data,origin){if(!/^https:\/\/[a-z0-9.-]+(?::\d+)?$/i.test(origin))return HtmlService.createHtmlOutput('Ошибка адреса сайта. Работа не записана.');const safe=x=>JSON.stringify(x).replace(/</g,'\\u003c');return HtmlService.createHtmlOutput('<!doctype html><meta charset="utf-8"><p>Обработка работы завершена. Вернитесь к игре.</p><script>for(var w=window,i=0;i<8;i++){w.postMessage('+safe(data)+','+safe(origin)+');if(w===w.parent)break;w=w.parent;}</script>').setXFrameOptionsMode(HtmlService.XFrameOptionsMode.ALLOWALL);}
function validateWork_(p){if(!p||p.game!=='bela-investigation-v2'||p.version!==2||!/^[a-f0-9-]{36}$/i.test(p.submissionId||''))throw new Error('Неверный формат работы.');if(!BelaEngine.validStudent(p.student))throw new Error('Проверьте анкету ученика.');if(!Array.isArray(p.order)||p.order.length!==5||new Set(p.order).size!==5||p.order.some(x=>!Number.isInteger(x)||x<0||x>4))throw new Error('Некорректная последовательность событий.');if(!p.answers||!p.done||[0,1,2,3,4].some(i=>p.done[i]!==true))throw new Error('Работа не завершена.');const a=p.answers;if(!Array.isArray(a.details)||a.details.length!==3||new Set(a.details).size!==3||a.details.some(x=>!Number.isInteger(x)||x<0||x>5))throw new Error('Некорректное задание с деталями.');const fields=['chain0','chain1','chain2','m0','m1','m2','m3','f0','f1','f2','f3','narrator','art0','art1','v0','v1','v2','v3','e0','e1','e2'];if(fields.some(k=>typeof a[k]!=='string'||!a[k].trim()||a[k].length>500))throw new Error('Не все ответы заполнены.');return true;}
function safeCell_(s){const t=String(s==null?'':s);return /^[\s]*[=+\-@]/.test(t)?"'"+t:t;}
function norm_(s){return String(s).trim().toLocaleLowerCase().replace(/\s+/g,' ');}
function storeWork_(p){validateWork_(p);const lock=LockService.getScriptLock();if(!lock.tryLock(20000))throw new Error('Приём занят. Повторите отправку через минуту.');try{const sh=getSheet_();if(sh.getLastRow()>1){const found=sh.getRange(2,2,sh.getLastRow()-1,1).createTextFinder(p.submissionId).matchEntireCell(true).findNext();if(found)return {receipt:'BELA-'+found.getRow(),duplicate:true};}const st=p.student,a=p.answers;let attempt=1;if(sh.getLastRow()>1){const rows=sh.getRange(2,4,sh.getLastRow()-1,3).getDisplayValues();attempt+=rows.filter(r=>norm_(r[0])===norm_(st.lastName)&&norm_(r[1])===norm_(st.firstName)&&norm_(r[2])===norm_(st.className)).length;}const scores=BelaEngine.marks(p),total=BelaEngine.points(scores.reduce((x,y)=>x+y,0));const row=[new Date().toISOString(),p.submissionId,attempt,st.lastName,st.firstName,st.className,p.startedAt,p.finishedAt,...scores,total,JSON.stringify({order:p.order,answers:a,readable:p.report||{}},null,2),'',''];sh.appendRow(row.map(v=>typeof v==='number'?v:safeCell_(v)));SpreadsheetApp.flush();return {receipt:'BELA-'+sh.getLastRow(),duplicate:false};}finally{lock.releaseLock();}}
function importWork(payload){if(typeof payload!=='string'||payload.length>70000)throw new Error('Неверный файл.');return storeWork_(JSON.parse(payload));}
function showImport(){const html=HtmlService.createHtmlOutput('<!doctype html><meta charset="utf-8"><p>Выберите JSON, скачанный учеником в конце игры.</p><input type="file" id="f" accept="application/json,.json"><p id="s"></p><script>document.getElementById("f").onchange=function(){var file=this.files[0];if(!file)return;var r=new FileReader();r.onload=function(){document.getElementById("s").textContent="Записываем…";google.script.run.withSuccessHandler(function(x){document.getElementById("s").textContent="Работа записана: "+x.receipt;}).withFailureHandler(function(){document.getElementById("s").textContent="Не удалось импортировать: проверьте файл и запуск setup.";}).importWork(r.result);};r.readAsText(file);};</script>').setWidth(460).setHeight(230);SpreadsheetApp.getUi().showModalDialog(html,'Импорт работы «Бэла»');}
